# Ignore everything by default
*

# Allow root-level source code and documentation
!/*.py
!/*.md
!/.gitignore
!/requirements.txt
!/pyproject.toml

# Allow utility source code
!/utilities/
/utilities/*
!/utilities/*.py
!/utilities/*.md

!/knowledge/
/knowledge/*
!/knowledge/*.json
!/knowledge/*.md


# Local source backups
/*_original.py
/*_backup.py
